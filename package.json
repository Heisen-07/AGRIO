{
  "name": "agrio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const fs = require('fs'); ['node_modules/.bin/vite', 'node_modules/vite/bin/vite.js'].forEach(p => { if (fs.existsSync(p)) { try { fs.chmodSync(p, 0o755); } catch {} } })\"",
    "build": "vite build",
    "postinstall": "node -e \"const fs = require('fs'); ['node_modules/.bin/vite', 'node_modules/vite/bin/vite.js'].forEach(p => { if (fs.existsSync(p)) { try { fs.chmodSync(p, 0o755); } catch {} } })\"",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.294.0",
    "onnxruntime-web": "^1.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "postcss": "^8.4.32",
